DATABASE_URL=postgresql://quiz_app:PASSWORT@HOST:6543/postgres
# Für Live-Updates über Supabase Realtime (optional, sonst nur Polling)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
